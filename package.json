{
  "name": "@maximekuntz/livery",
  "version": "0.1.4",
  "description": "Rail-inspired design system for Vue 3",
  "type": "module",
  "main": "./dist/livery.umd.cjs",
  "module": "./dist/livery.js",
  "exports": {
    ".": {
      "import": "./dist/livery.js",
      "require": "./dist/livery.umd.cjs"
    },
    "./dist/livery.css": "./dist/livery.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-links": "^10.4.1",
    "@storybook/vue3-vite": "^10.4.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "storybook": "^10.4.1",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}