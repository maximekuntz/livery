{
  "name": "@maximekuntz/livery",
  "version": "0.1.5",
  "description": "Rail-inspired design system for Vue 3",
  "type": "module",
  "main": "./dist/livery.umd.cjs",
  "module": "./dist/livery.js",
  "exports": {
    ".": {
      "import": "./dist/livery.js",
      "require": "./dist/livery.umd.cjs"
    },
    "./dist/livery.css": "./dist/livery.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "lint": "eslint src --ext .js,.vue",
    "lint:fix": "eslint src --ext .js,.vue --fix",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "storybook": "^10.6.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1",
    "eslint-plugin-storybook": "10.6.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}
